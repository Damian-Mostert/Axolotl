const canvas: object = createCanvas(800, 600);
const scene: object = createScene();
const camera: object = PerspectiveCamera(60);
camera.setPosition(0, 1, 5);

const human: object = loadOBJ("examples/human.obj");
human.setColor("#ffaa88");
human.setPosition(0, 0, 0);
scene.add(human);

const light: object = PointLight("#ffffff", 1);
light.setPosition(3, 5, 3);
scene.add(light);

enableDevMode(camera);

while (handleDevInput() == 1) {
    updateDevCamera();
    canvas.render(scene, camera);
}
