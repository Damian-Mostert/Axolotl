const canvas: object = createCanvas(800, 600);
const scene: object = createScene();
const camera: object = PerspectiveCamera(60);
camera.setPosition(0, 15, 25);
camera.lookAt(0, 0, 0);
enableDevMode(camera);

const sun: object = PointLight("#ffeeaa", 2);
sun.setPosition(20, 30, 10);
scene.add(sun);

const terrain: object = BoxGeometry(40, 1, 40);
terrain.setPosition(0, -0.5, 0);
terrain.deformVertices(2.0, 0.3, 1.5);
terrain.setColor("#667744");
terrain.setFriction(0.3);
terrain.setBounciness(0.2);
scene.add(terrain);

const player: object = BoxGeometry(1, 2, 1);
player.setPosition(0, 5, 0);
player.setColor("#3388ff");
scene.add(player);

const ball: object = SphereGeometry(0.8);
ball.setPosition(5, 10, 5);
ball.setColor("#ff6666");
scene.add(ball);

var angle: float = 0.0;
var canJump: int = 1;

while (handleDevInput() == 1) {
    updateDevCamera();
    
    const keys: object = getKeyState();
    
    if (keys.left == 1) { angle = angle - 0.05; }
    if (keys.right == 1) { angle = angle + 0.05; }
    
    if (keys.up == 1) {
        player.moveBy(sin(angle) * 0.2, 0, cos(angle) * 0.2);
        handleCollision(player, terrain);
    }
    if (keys.down == 1) {
        player.moveBy(0.0 - sin(angle) * 0.2, 0, 0.0 - cos(angle) * 0.2);
        handleCollision(player, terrain);
    }
    if (keys.space == 1) {
        if (canJump == 1) {
            player.addVelocity(0, 0.3, 0);
            canJump = 0;
        }
    }
    if (keys.space == 0) {
        canJump = 1;
    }
    
    applyAttractionToMesh(player, terrain);
    handleCollision(player, terrain);
    
    applyAttractionToMesh(ball, terrain);
    handleCollision(ball, terrain, player);
    
    player.setRotation(0, angle, 0);
    
    canvas.render(scene, camera);
}
