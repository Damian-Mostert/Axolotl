var x: int = 5
var y: int = 10

// Single line if without braces
if (x < y) print("x is less than y")

// Single line if-else without braces
if (x > y)
    print("x is greater")
else
    print("y is greater or equal")

// Mixed: braces and no braces
var counter: int = 0
while (counter < 3) {
    print("Counter: ")
    print(counter)
    counter = counter + 1
}

// Single line while
var i: int = 0
while (i < 3) i = i + 1

// Single line for
for (var j: int = 0; j < 5; j = j + 1) print(j)

// Nested single line
if (x < 10)
    if (y > 5)
        print("Both conditions met")

// JavaScript-style compact if
if (x == 5) x = x + 1
if (y == 10) y = y - 1

print("Final x: ")
print(x)
print("Final y: ")
print(y)
