const canvas: object = createCanvas(800, 600);
const scene: object = createScene();
const camera: object = PerspectiveCamera(60);
camera.setPosition(0, 4, 25);

const ground: object = PlaneGeometry(50, 50);
ground.setPosition(0, 0, 0);
ground.setRotation(1.57, 0, 0);
ground.setColor("#556633");
scene.add(ground);

const building1: object = BoxGeometry(5, 8, 5);
building1.setPosition(-10, 4, -10);
building1.setColor("#8899aa");
scene.add(building1);

const building2: object = BoxGeometry(4, 6, 4);
building2.setPosition(12, 3, -8);
building2.setColor("#aa8877");
scene.add(building2);

const building3: object = BoxGeometry(6, 10, 6);
building3.setPosition(-5, 5, 15);
building3.setColor("#7788aa");
scene.add(building3);

const tower: object = CylinderGeometry(2, 2, 12);
tower.setPosition(15, 6, 12);
tower.setColor("#cc6666");
scene.add(tower);

const tree1: object = CylinderGeometry(0.5, 0.5, 4);
tree1.setPosition(5, 2, 5);
tree1.setColor("#664422");
scene.add(tree1);

const leaves1: object = SphereGeometry(2);
leaves1.setPosition(5, 5, 5);
leaves1.setColor("#228844");
scene.add(leaves1);

const tree2: object = CylinderGeometry(0.5, 0.5, 4);
tree2.setPosition(-8, 2, 8);
tree2.setColor("#664422");
scene.add(tree2);

const leaves2: object = SphereGeometry(2);
leaves2.setPosition(-8, 5, 8);
leaves2.setColor("#228844");
scene.add(leaves2);

const player: object = BoxGeometry(1, 2, 1);
player.setPosition(0, 1, 20);
player.setColor("#3388ff");
scene.add(player);

const sun: object = PointLight("#ffeeaa", 2);
sun.setPosition(20, 30, 10);
scene.add(sun);

var posX: float = 0.0;
var posZ: float = 20.0;
var angle: float = 0.0;
var speed: float = 0.2;

while (handleDevInput() == 1) {
    const keys: object = getKeyState();
    
    var newX: float = 0.0;
    var newZ: float = 0.0;
    
    newX = posX;
    newZ = posZ;
    
    if (keys.up == 1) {
        newX = posX + sin(angle) * speed;
        newZ = posZ + cos(angle) * speed;
    }
    if (keys.down == 1) {
        newX = posX - sin(angle) * speed;
        newZ = posZ - cos(angle) * speed;
    }
    if (keys.left == 1) {
        angle = angle - 0.05;
    }
    if (keys.right == 1) {
        angle = angle + 0.05;
    }
    
    player.setPosition(newX, 1, newZ);
    
    if (isColliding(player, building1, building2, building3, tower, tree1, tree2) == 0) {
        posX = newX;
        posZ = newZ;
    }
    
    player.setPosition(posX, 1, posZ);
    player.setRotation(0, angle, 0);
    
    const camDist: float = 6.0;
    const camHeight: float = 4.0;
    const camX: float = posX - sin(angle) * camDist;
    const camZ: float = posZ - cos(angle) * camDist;
    camera.setPosition(camX, camHeight, camZ);
    camera.lookAt(posX, 1.5, posZ);
    sun.setPosition(posX + 20, 30, posZ + 10);
    
    canvas.render(scene, camera);
}
