// Graphics Settings Example
// Demonstrates all scene configuration options

const canvas: object = createCanvas(800, 600, "Graphics Settings Demo");
const scene: object = createScene();
const camera: object = PerspectiveCamera(75);
camera.setPosition(0, 5, 10);
camera.lookAt(0, 0, 0);

// Create some objects
const box: object = BoxGeometry(2);
box.setPosition(-3, 1, 0);
box.setColor("#ff6b6b");
scene.add(box);

const sphere: object = SphereGeometry(1);
sphere.setPosition(0, 1, 0);
sphere.setColor("#4ecdc4");
sphere.setMetallic(0.8);
scene.add(sphere);

const torus: object = TorusGeometry(1, 0.3);
torus.setPosition(3, 1, 0);
torus.setColor("#95e1d3");
scene.add(torus);

const ground: object = PlaneGeometry(20, 20);
ground.setRotation(1.57, 0, 0);
ground.setColor("#2d3436");
scene.add(ground);

// Add lighting
const light: object = PointLight("#ffffff", 1.5);
light.setPosition(5, 10, 5);
scene.add(light);

// Configure graphics settings
const settings: object = {
    msaa: 1,              // Enable multi-sample anti-aliasing
    msaaSamples: 4,       // 4x MSAA samples
    depthTest: 1,         // Enable depth testing
    smoothing: 1,         // Enable line/polygon smoothing
    shadows: 1,           // Enable shadows
    shadowIntensity: 0.5, // 50% shadow darkness
    fog: 1,               // Enable fog
    fogDensity: 0.02,     // Fog density
    fogColor: "#636e72"   // Fog color (gray)
};

setGraphics(scene, settings);

// Animation loop
var rotation: float = 0.0;

while (handleInput()) {
    rotation = rotation + 0.02;
    
    box.setRotation(rotation, rotation * 0.5, 0);
    sphere.setRotation(0, rotation, 0);
    torus.setRotation(rotation * 0.5, 0, rotation);
    
    canvas.render(scene, camera);
}
