const canvas: object = createCanvas(800, 600);
const scene: object = createScene();
const camera: object = PerspectiveCamera(60);
camera.setPosition(0, 15, 35);
camera.lookAt(0, 5, 0);
enableDevMode(camera);

const sun: object = PointLight("#ffeeaa", 2);
sun.setPosition(20, 30, 10);
scene.add(sun);

const ground: object = BoxGeometry(60, 1, 60);
ground.setPosition(0, -0.5, 0);
ground.setColor("#556633");
ground.setFriction(0.2);
ground.setBounciness(5);
scene.add(ground);

const ramp1: object = BoxGeometry(15, 1, 20);
ramp1.setPosition(-20, 3, 0);
ramp1.setRotation(0, 0, 0.4);
ramp1.setColor("#aa8866");
ramp1.setFriction(0.15);
scene.add(ramp1);

const ramp2: object = BoxGeometry(15, 1, 20);
ramp2.setPosition(20, 3, 0);
ramp2.setRotation(0.3, 0, 0);
ramp2.setColor("#88aa66");
ramp2.setFriction(0.15);
scene.add(ramp2);

const platform: object = BoxGeometry(10, 1, 10);
platform.setPosition(0, 8, -15);
platform.setRotation(0.2, 0.3, 0.1);
platform.setColor("#6688aa");
platform.setFriction(0.1);
scene.add(platform);

const box1: object = BoxGeometry(1.5, 1.5, 1.5);
box1.setPosition(-22, 25, -5);
box1.setColor("#ff6666");
scene.add(box1);

const box2: object = BoxGeometry(1.2, 1.2, 1.2);
box2.setPosition(-18, 28, 0);
box2.setColor("#ff8866");
scene.add(box2);

const box3: object = BoxGeometry(1, 1, 1);
box3.setPosition(-20, 30, 5);
box3.setColor("#ffaa66");
scene.add(box3);

const sphere1: object = SphereGeometry(0.8);
sphere1.setPosition(18, 26, -5);
sphere1.setColor("#66ff66");
scene.add(sphere1);

const sphere2: object = SphereGeometry(1);
sphere2.setPosition(22, 29, 0);
sphere2.setColor("#66ffaa");
scene.add(sphere2);

const sphere3: object = SphereGeometry(0.6);
sphere3.setPosition(20, 32, 5);
sphere3.setColor("#66ffff");
scene.add(sphere3);

const cylinder1: object = CylinderGeometry(0.8, 0.8, 2);
cylinder1.setPosition(-2, 27, -15);
cylinder1.setColor("#6666ff");
scene.add(cylinder1);

const cylinder2: object = CylinderGeometry(0.6, 0.6, 1.5);
cylinder2.setPosition(0, 30, -15);
cylinder2.setColor("#8866ff");
scene.add(cylinder2);

const cylinder3: object = CylinderGeometry(1, 1, 2.5);
cylinder3.setPosition(2, 33, -15);
cylinder3.setColor("#aa66ff");
scene.add(cylinder3);

const torus1: object = TorusGeometry(1, 0.3);
torus1.setPosition(-5, 20, 10);
torus1.setColor("#ff66ff");
scene.add(torus1);

const torus2: object = TorusGeometry(0.8, 0.25);
torus2.setPosition(0, 23, 10);
torus2.setColor("#ff66aa");
scene.add(torus2);

const torus3: object = TorusGeometry(1.2, 0.35);
torus3.setPosition(5, 26, 10);
torus3.setColor("#ff6688");
scene.add(torus3);

while (handleDevInput() == 1) {
    updateDevCamera();
    
    applyAttractionToMesh(box1, ground);
    handleCollision(box1, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(box2, ground);
    handleCollision(box2, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(box3, ground);
    handleCollision(box3, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(sphere1, ground);
    handleCollision(sphere1, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(sphere2, ground);
    handleCollision(sphere2, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(sphere3, ground);
    handleCollision(sphere3, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(cylinder1, ground);
    handleCollision(cylinder1, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(cylinder2, ground);
    handleCollision(cylinder2, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(cylinder3, ground);
    handleCollision(cylinder3, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(torus1, ground);
    handleCollision(torus1, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(torus2, ground);
    handleCollision(torus2, ground, ramp1, ramp2, platform);
    
    applyAttractionToMesh(torus3, ground);
    handleCollision(torus3, ground, ramp1, ramp2, platform);
    
    canvas.render(scene, camera);
}
