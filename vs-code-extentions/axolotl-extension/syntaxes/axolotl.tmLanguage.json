{
  "name": "Axolotl",
  "scopeName": "source.axolotl",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#builtin-functions"},
    {"include": "#custom-types"},
    {"include": "#functions"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.double-slash.axolotl",
        "match": "//.*$"
      }]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.axolotl",
        "match": "\\b(if|else|while|for|return|break|continue|switch|case|default|try|catch|finally|throw)\\b"
      }, {
        "name": "keyword.other.axolotl",
        "match": "\\b(var|const|func|program|import|export|use|type|await|typeof)\\b"
      }, {
        "name": "constant.language.axolotl",
        "match": "\\b(true|false)\\b"
      }]
    },
    "types": {
      "patterns": [{
        "name": "storage.type.primitive.axolotl",
        "match": "\\b(int|float|string|bool|void|any|object)\\b"
      }]
    },
    "custom-types": {
      "patterns": [{
        "name": "entity.name.type.axolotl",
        "match": "(?<=type\\s+)([a-zA-Z_][a-zA-Z0-9_]*)\\b"
      }, {
        "name": "entity.name.type.axolotl",
        "match": "(?<=:\\s*)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*[=;,)])"
      }]
    },
    "builtin-functions": {
      "patterns": [{
        "name": "support.function.builtin.axolotl",
        "match": "\\b(print|len|push|pop|read|write|readDir|assert|error|sleep|millis|random|pow|atan2|abs|floor|ceil|round|min|max|clamp|lerp|typeof|toInt|toFloat|toString|toBool|toUpper|toLower|trim|split|join|replace|slice|substr|indexOf|includes|startsWith|endsWith|repeat|charAt|charCodeAt|reverse|sort|find|contains|keys|values|merge|clone|copy|hasKey|json_parse|json_stringify|fetch|createServer|writeHead|end|close|createCanvas|fillRect|strokeRect|clearRect|fillCircle|drawLine|drawImage|fillStyle|strokeStyle|loadImage|loadCSS|getKeyState|isKeyDown|isMouseDown|wasMouseClicked|getMouseX|getMouseY|pollEvents|updateInputs|createScene|render|renderWindow|CreateWindow|loadOBJ|setPosition|setRotation|setScale|setColor|getPosition|lookAt|followTarget|moveBy|add|PerspectiveCamera|BoxGeometry|SphereGeometry|PlaneGeometry|CylinderGeometry|TorusGeometry|PointLight|DirectionalLight|AmbientLight|setGraphics|setMetallic|enableDevMode|updateDevCamera|handleDevInput|applyGravity|handleCollision|isColliding|setBounciness|setFriction|addVelocity|applyNaturalCollision|getGroundNormal|applyAttractionToMesh|deformVertices|mysqlConnect|query|wsConnect|send|receive)\\s*(?=\\()"
      }]
    },
    "strings": {
      "patterns": [{
        "name": "string.quoted.double.axolotl",
        "begin": "\"",
        "end": "\"",
        "patterns": [{
          "name": "constant.character.escape.axolotl",
          "match": "\\\\(n|t|r|\\\"|\\\\)"
        }]
      }]
    },
    "numbers": {
      "patterns": [{
        "name": "constant.numeric.float.axolotl",
        "match": "\\b\\d+\\.\\d+\\b"
      }, {
        "name": "constant.numeric.integer.axolotl",
        "match": "\\b\\d+\\b"
      }]
    },
    "functions": {
      "patterns": [{
        "name": "entity.name.function.axolotl",
        "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(?=\\()"
      }, {
        "name": "entity.name.function.axolotl",
        "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
      }]
    },
    "operators": {
      "patterns": [{
        "name": "keyword.operator.axolotl",
        "match": "(==|!=|<=|>=|<|>|&&|\\|\\||!|\\+|-|\\*|/|%|=)"
      }]
    }
  }
}
