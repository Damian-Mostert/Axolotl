{
  "scopeName": "source.axolotl",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#builtins"},
    {"include": "#functions"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {
      "patterns": [{"name": "comment.line.axolotl", "match": "//.*$"}]
    },
    "strings": {
      "patterns": [{"name": "string.quoted.double.axolotl", "begin": "\"", "end": "\""}]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.float.axolotl", "match": "\\b\\d+\\.\\d+\\b"},
        {"name": "constant.numeric.integer.axolotl", "match": "\\b\\d+\\b"}
      ]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.axolotl",
        "match": "\\b(var|const|func|return|if|else|for|while|break|continue|try|catch|finally|throw|type|switch|case|default)\\b"
      }]
    },
    "types": {
      "patterns": [{
        "name": "storage.type.axolotl",
        "match": "\\b(int|float|string|bool|void|object|any)\\b"
      }]
    },
    "builtins": {
      "patterns": [{
        "name": "support.function.builtin.axolotl",
        "match": "\\b(print|len|push|pop|slice|reverse|join|sort|find|includes|substr|toUpper|toLower|indexOf|contains|trim|replace|split|startsWith|endsWith|repeat|charAt|charCodeAt|millis|sleep|typeof|toString|toInt|toFloat|toBool|sin|cos|tan|sqrt|pow|abs|floor|ceil|round|min|max|random|log|log10|exp|asin|acos|atan|atan2|clamp|lerp|keys|values|hasKey|clone|merge|assert|error|read|write|copy|readDir|fetch|createCanvas|createServer|fillStyle|strokeStyle|fillRect|strokeRect|clearRect|fillCircle|render|pollEvents|updateInputs|isKeyDown|isMouseDown|wasMouseClicked|getMouseX|getMouseY|json_parse|json_stringify|drawImage|loadImage|createBox|createSphere|createCamera|setPosition|setRotation|renderMesh|setLoop|clear)\\b"
      }]
    },
    "functions": {
      "patterns": [{
        "name": "entity.name.function.axolotl",
        "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
      }]
    },
    "operators": {
      "patterns": [{
        "name": "keyword.operator.axolotl",
        "match": "(->|==|!=|<=|>=|<|>|&&|\\|\\||!|[+\\-*/%=])"
      }]
    }
  }
}
