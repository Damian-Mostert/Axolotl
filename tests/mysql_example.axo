// MySQL Database Example
// Connect to MySQL and perform queries

// Connect to database
const db: object = mysqlConnect("localhost", "root", "", "mydb");

// Create table
db.query("CREATE TABLE IF NOT EXISTS users (id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(255), email VARCHAR(255))");

// Insert data
db.query("INSERT INTO users (name, email) VALUES ('Alice', 'alice@example.com')");
db.query("INSERT INTO users (name, email) VALUES ('Bob', 'bob@example.com')");

// Query data
const users: any = db.query("SELECT * FROM users");

// Print results
var i: int = 0;
while (i < len(users)) {
    const user: any = users[i];
    print("User: " + user.name + " - " + user.email);
    i = i + 1;
}

// Update data
db.query("UPDATE users SET email = 'newemail@example.com' WHERE name = 'Alice'");

// Delete data
db.query("DELETE FROM users WHERE name = 'Bob'");

// Close connection
db.close();
