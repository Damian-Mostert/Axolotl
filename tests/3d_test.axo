// 3D Wireframe Test
print("Creating 3D scene...");

var canvas: object = createCanvas(800, 600, "3D Test");
var box: object = createBox(2.0, 2.0, 2.0);
var sphere: object = createSphere(1.5, 20);
var camera: object = createCamera(60.0);

camera.setPosition(0.0, 0.0, 8.0);
box.setPosition(-3.0, 0.0, -5.0);
sphere.setPosition(3.0, 0.0, -5.0);

canvas.fillStyle("#000000");
canvas.fillRect(0, 0, 800, 600);
canvas.strokeStyle("#00ff00");

canvas.renderMesh(box, camera);
canvas.strokeStyle("#ff0000");
canvas.renderMesh(sphere, camera);
canvas.render();

print("Rendered! Box (green) left, Sphere (red) right");
print("Close window to exit");

var running: int = 1;
while (running == 1) {
    pollEvents();
}
