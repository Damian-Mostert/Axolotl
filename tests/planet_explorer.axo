// Planet Explorer - Real Gameplay with Radial Gravity
// Arrow keys to move, Space to jump

const canvas: object = createCanvas(1200, 800);
const scene: object = createScene();
const camera: object = PerspectiveCamera(75);

const universe: object = createUniverse();
universe.addRadialGravityLaw(0, 0, 0, 0.08);

const planet: object = SphereGeometry(15, 64, 48);
planet.setPosition(0, 0, 0);
planet.setColor("#2d5016");
scene.add(planet);
universe.addBody(planet, 0, 1);

const player: object = BoxGeometry(0.6, 1.8, 0.6);
player.setPosition(0, 18, 0);
player.setColor("#ff6b6b");
scene.add(player);
universe.addBody(player, 70, 0);

const light: object = PointLight("#ffffff", 1.5);
light.setPosition(30, 30, 30);
scene.add(light);

var angle: float = 0.0;
var score: int = 0;

while (handleDevInput() == 1) {
    const keys: object = getKeyState();
    const pos: object = player.getPosition();
    
    var px: float = 0.0;
    var py: float = 0.0;
    var pz: float = 0.0;
    px = px + pos.x;
    py = py + pos.y;
    pz = pz + pos.z;
    const dist: float = sqrt(px * px + py * py + pz * pz);
    
    var upX: float = 0.0;
    var upY: float = 0.0;
    var upZ: float = 0.0;
    upX = px / dist;
    upY = py / dist;
    upZ = pz / dist;
    
    var rightX: float = 0.0;
    var rightZ: float = 0.0;
    rightX = upZ;
    rightZ = 0.0 - upX;
    const rightLen: float = sqrt(rightX * rightX + rightZ * rightZ);
    rightX = rightX / rightLen;
    rightZ = rightZ / rightLen;
    
    var fwdX: float = 0.0;
    var fwdY: float = 0.0;
    var fwdZ: float = 0.0;
    fwdX = upY * rightZ;
    fwdY = 0.0 - upX * rightZ;
    fwdZ = upX * 0.0 - upY * rightX;
    
    if (keys.left == 1) { angle = angle - 0.05; }
    if (keys.right == 1) { angle = angle + 0.05; }
    
    if (keys.up == 1) {
        player.addVelocity(fwdX * 0.15, fwdY * 0.15, fwdZ * 0.15);
    }
    if (keys.down == 1) {
        player.addVelocity(0.0 - fwdX * 0.15, 0.0 - fwdY * 0.15, 0.0 - fwdZ * 0.15);
    }
    if (keys.space == 1) {
        player.addVelocity(upX * 0.2, upY * 0.2, upZ * 0.2);
    }
    
    universe.step(0.016);
    
    const camDist: float = 8.0;
    camera.setPosition(
        pos.x + upX * camDist - sin(angle) * 5,
        pos.y + upY * camDist + 3,
        pos.z + upZ * camDist - cos(angle) * 5
    );
    camera.lookAt(pos.x, pos.y, pos.z);
    
    canvas.render(scene, camera);
}
