// Sprite Demo with Image Loading
print("Sprite Demo - Loading sprite.png");

const canvas: object = createCanvas(800, 600);
const sprite: object = loadImage("examples/assets/sprite.png");

print("Sprite loaded:", sprite.width, "x", sprite.height);

var playerX: int = 400;
var playerY: int = 300;
var velocityX: int = 0;
var velocityY: int = 0;
const speed: int = 4;

print("Controls: WASD or Arrow Keys to move");

var running: bool = true;

while (running) {
    updateInputs();
    
    velocityX = 0;
    velocityY = 0;
    
    if (isKeyDown("W") || isKeyDown("Up")) {
        velocityY = 0 - speed;
    }
    if (isKeyDown("S") || isKeyDown("Down")) {
        velocityY = speed;
    }
    if (isKeyDown("A") || isKeyDown("Left")) {
        velocityX = 0 - speed;
    }
    if (isKeyDown("D") || isKeyDown("Right")) {
        velocityX = speed;
    }
    
    playerX = playerX + velocityX;
    playerY = playerY + velocityY;
    
    if (playerX < 0) {
        playerX = 0;
    }
    if (playerX > 736) {
        playerX = 736;
    }
    if (playerY < 0) {
        playerY = 0;
    }
    if (playerY > 536) {
        playerY = 536;
    }
    
    canvas.fillStyle("#2c3e50");
    canvas.fillRect(0, 0, 800, 600);
    
    canvas.fillStyle("#34495e");
    var i: int = 0;
    while (i < 800) {
        canvas.fillRect(i, 0, 2, 600);
        i = i + 100;
    }
    i = 0;
    while (i < 600) {
        canvas.fillRect(0, i, 800, 2);
        i = i + 100;
    }
    
    canvas.drawImage(sprite, playerX, playerY);
    
    canvas.render();
    sleep(16);
}

print("Demo complete!");
