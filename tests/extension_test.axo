// Test file for VS Code extension features

// Type inference - should infer as 'any'
const player = BoxGeometry(0.8, 1.6, 0.8);
const scene = createScene();
const camera = PerspectiveCamera(60.0);

// Explicit types
const x: int = 42;
const y: float = 3.14;
const name: string = "Test";

// Type inference with literals
const num = 100;
const pi = 3.14159;
const greeting = "Hello";
const flag = true;

// Array type inference
const numbers = [1, 2, 3, 4, 5];
const names = ["Alice", "Bob", "Charlie"];

// Function with return type
func calculate(a: int, b: int) -> int {
    return a + b;
}

// Variable reassignment - should error on const
// player = BoxGeometry(1.0, 2.0, 1.0);  // Error: cannot reassign const

// Type mismatch - should warn
var count: int = 0;
// count = "string";  // Warning: type mismatch

// Undefined variable - should error
// undefinedVar = 10;  // Error: not declared

// Undefined function - should warn
// unknownFunction();  // Warning: not defined

// Valid operations
count = count + 1;
const result: int = calculate(5, 10);

print("Test completed");
