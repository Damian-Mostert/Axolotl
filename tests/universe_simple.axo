const canvas: object = createCanvas(800, 600);
const scene: object = createScene();
const camera: object = PerspectiveCamera(60);
camera.setPosition(0, 10, 25);
camera.lookAt(0, 5, 0);
enableDevMode(camera);

const universe: object = createUniverse();
universe.addGravityLaw(0, -1, 0, 0.5);

const ground: object = BoxGeometry(40, 1, 40);
ground.setPosition(0, -0.5, 0);
ground.setColor("#556633");
ground.setFriction(0.6);
scene.add(ground);
universe.addBody(ground, 0, 1);

const player: object = BoxGeometry(1, 2, 1);
player.setPosition(0, 10, 0);
player.setColor("#ff6b6b");
scene.add(player);
universe.addBody(player, 60, 0);

const box1: object = BoxGeometry(2, 2, 2);
box1.setPosition(5, 15, 0);
box1.setColor("#66ff66");
scene.add(box1);
universe.addBody(box1, 10, 0);

const box2: object = BoxGeometry(1.5, 1.5, 1.5);
box2.setPosition(-5, 20, 0);
box2.setColor("#6666ff");
scene.add(box2);
universe.addBody(box2, 8, 0);

const light: object = PointLight("#ffffff", 2);
light.setPosition(20, 30, 20);
scene.add(light);

while (handleDevInput() == 1) {
    updateDevCamera();
    universe.step(0.016);
    canvas.render(scene, camera);
}
