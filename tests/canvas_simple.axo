// Simple Canvas Test
print("Creating canvas...");

var canvas: object = createCanvas(400, 300, "Simple Test");

print("Canvas created");

canvas.fillStyle("#ff0000");
canvas.fillRect(50, 50, 100, 100);

canvas.strokeStyle("#0000ff");
canvas.strokeRect(200, 50, 100, 100);

canvas.render();

print("Rendered - check window");
print("Processing events for 3 seconds...");

var start: int = millis();
while (millis() - start < 3000) {
    pollEvents();
}

print("Done");
