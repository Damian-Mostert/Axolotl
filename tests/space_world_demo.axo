// Space World Demo - Mario Galaxy Style Planet Walking

const canvas = createCanvas(800, 600)
const scene = createScene()
const camera = PerspectiveCamera(60)

// Create space world (no default gravity)
const world = createWorld("space")

// Add planet as gravity source at origin
world.addGravitySource(0, 0, 0)

// Create planet mesh
const planet = SphereGeometry(3, 32, 24)
planet.setPosition(0, 0, 0)
planet.setColor("#8844FF")

// Create player entity
const playerMesh = BoxGeometry(0.5, 0.5, 0.5)
playerMesh.setColor("#FFFF44")
const player = world.createEntity(playerMesh)
player.setPosition(5, 0, 0)
player.setVelocity(0, 0, 2)

// Add lighting
const light = PointLight("#FFFFFF", 2)
light.setPosition(10, 10, 10)

// Setup scene
scene.add(planet)
scene.add(playerMesh)
scene.add(light)

// Position camera
camera.setPosition(0, 8, 12)
camera.lookAt(0, 0, 0)

// Game loop
var running = 1
var time = 0
while (running == 1) {
    // Physics step
    world.step(0.016)
    time = time + 0.016
    
    // Get player position
    const pos = player.position()
    
    // Update mesh to match physics
    playerMesh.setPosition(pos.x, pos.y, pos.z)
    
    // Rotate planet slowly
    planet.setRotation(0, time * 0.2, 0)
    
    // Check if player is within range of planet
    if (world.isWithinRange(player, planet, 3.5)) {
        print("Player on planet surface!")
    }
    
    // Render
    canvas.render(scene, camera)
    
    // Handle input
    running = handleDevInput()
}

print("Space world demo complete!")
