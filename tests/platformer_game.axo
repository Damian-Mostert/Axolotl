// 3D Platformer - Traditional Gravity Gameplay
// Arrow keys to move, Space to jump, collect all coins!

const canvas: any = createCanvas(1200, 800);
const scene: any = createScene();
const camera: any = PerspectiveCamera(60.0);

// Universe with planar gravity
const universe: any = createUniverse();
universe.addGravityLaw(0.0, -1.0, 0.0, 0.8);

// Ground
const ground: any = BoxGeometry(30.0, 1.0, 30.0);
ground.setPosition(0.0, -1.0, 0.0);
ground.setColor("#34495e");
ground.setFriction(0.8);
scene.add(ground);
universe.addBody(ground, 0.0, 1);

// Platforms
const platforms: [any] = [];

func createPlatform(x: float, y: float, z: float, w: float, h: float, d: float) -> void {
    const plat: any = BoxGeometry(w, h, d);
    plat.setPosition(x, y, z);
    plat.setColor("#95a5a6");
    plat.setFriction(0.6);
    scene.add(plat);
    universe.addBody(plat, 0.0, 1);
    platforms.push(plat);
}

createPlatform(5.0, 2.0, 0.0, 4.0, 0.5, 4.0);
createPlatform(10.0, 4.0, 0.0, 4.0, 0.5, 4.0);
createPlatform(5.0, 6.0, 5.0, 4.0, 0.5, 4.0);
createPlatform(-5.0, 3.0, 5.0, 4.0, 0.5, 4.0);
createPlatform(-10.0, 5.0, 0.0, 4.0, 0.5, 4.0);
createPlatform(0.0, 8.0, -5.0, 4.0, 0.5, 4.0);

// Player
const player: any = BoxGeometry(0.8, 1.6, 0.8);
player.setPosition(0.0, 5.0, 0.0);
player.setColor("#e74c3c");
scene.add(player);
universe.addBody(player, 60.0, 0);

// Coins
const coins: [any] = [];
var totalCoins: int = 8;
var collected: int = 0;

func spawnCoin(x: float, y: float, z: float) -> void {
    const coin: any = SphereGeometry(0.3, 16, 12);
    coin.setPosition(x, y, z);
    coin.setColor("#f1c40f");
    scene.add(coin);
    universe.addBody(coin, 0.0, 1);
    coins.push(coin);
}

spawnCoin(5.0, 3.5, 0.0);
spawnCoin(10.0, 5.5, 0.0);
spawnCoin(5.0, 7.5, 5.0);
spawnCoin(-5.0, 4.5, 5.0);
spawnCoin(-10.0, 6.5, 0.0);
spawnCoin(0.0, 9.5, -5.0);
spawnCoin(8.0, 1.0, 8.0);
spawnCoin(-8.0, 1.0, -8.0);

// Lighting
const light: any = PointLight("#ffffff", 2.0);
light.setPosition(0.0, 20.0, 10.0);
scene.add(light);

var moveSpeed: float = 0.2;
var jumpPower: float = 0.4;
var canJump: int = 1;
var frame: int = 0;

// Game loop
var running: int = 1;
var gameTime: float = 0.0;

while (running == 1 && collected < totalCoins) {
    running = handleDevInput();
    
    const pos: any = player.getPosition();
    const vel: any = player.getVelocity();
    
    // Movement
    const keys: any = getKeyState();
    
    if (keys.left == 1) {
        player.addVelocity(-moveSpeed, 0.0, 0.0);
    }
    if (keys.right == 1) {
        player.addVelocity(moveSpeed, 0.0, 0.0);
    }
    if (keys.up == 1) {
        player.addVelocity(0.0, 0.0, -moveSpeed);
    }
    if (keys.down == 1) {
        player.addVelocity(0.0, 0.0, moveSpeed);
    }
    
    // Jump
    if (keys.space == 1 && canJump == 1) {
        player.addVelocity(0.0, jumpPower, 0.0);
        canJump = 0;
    }
    
    // Ground check
    if (pos.y < 0.5 || vel.y == 0.0) {
        canJump = 1;
    }
    
    // Horizontal damping
    player.addVelocity(vel.x * -0.1, 0.0, vel.z * -0.1);
    
    // Physics
    universe.step(0.016);
    
    // Collect coins
    var i: int = 0;
    while (i < len(coins)) {
        const coin: any = coins[i];
        const coinPos: any = coin.getPosition();
        const dx: float = pos.x - coinPos.x;
        const dy: float = pos.y - coinPos.y;
        const dz: float = pos.z - coinPos.z;
        const dist: float = sqrt(dx * dx + dy * dy + dz * dz);
        
        if (dist < 1.2) {
            scene.removeMesh(coin);
            collected = collected + 1;
            print("Coins: " + str(collected) + "/" + str(totalCoins));
        }
        i = i + 1;
    }
    
    // Rotate coins
    var j: int = 0;
    while (j < len(coins)) {
        const coin: any = coins[j];
        coin.setRotation(0.0, frame * 0.05, 0.0);
        j = j + 1;
    }
    
    // Reset if fall off
    if (pos.y < -10.0) {
        player.setPosition(0.0, 5.0, 0.0);
        player.addVelocity(-vel.x, -vel.y, -vel.z);
    }
    
    // Third person camera
    camera.setPosition(pos.x - 8.0, pos.y + 6.0, pos.z + 8.0);
    camera.lookAt(pos.x, pos.y, pos.z);
    
    canvas.render(scene, camera);
    frame = frame + 1;
    gameTime = gameTime + 0.016;
}

if (collected == totalCoins) {
    print("YOU WIN! Time: " + str(gameTime) + "s");
} else {
    print("Game Over!");
}
