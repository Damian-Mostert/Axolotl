// Test process global object

// Access environment variables from .env file
print("TEST env var: " + process.env.TEST);
print("API_KEY: " + process.env.API_KEY);
print("PORT: " + process.env.PORT);

// Access current working directory
print("Current directory: " + process.cwd);

// Access command-line arguments (will be populated by main)
print("Number of args: " + toString(len(process.args)));
