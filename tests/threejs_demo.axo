// Three.js-like 3D Engine Demo
print("Axolotl 3D Engine - Three.js API");

// Create canvas (renderer)
var canvas: object = createCanvas(800, 600, "Axolotl 3D - Three.js API");

var ambientLight: object = AmbientLight("#404040", 0.3);

// Create scene
var scene: object = createScene();

// Create camera
var camera: object = PerspectiveCamera(75.0);
camera.setPosition(0.0, 2.0, 8.0);
camera.lookAt(0.0, 0.0, 0.0);
const x = {
    x:quality: "high",
};


// Create geometries
var box: object = BoxGeometry(2.0, 2.0, 2.0);
box.setPosition(-4.0, 0.0, 0.0);
box.setRotation(0.5, 0.5, 0.0);

var sphere: object = SphereGeometry(1.5, 20, 16);
sphere.setPosition(0.0, 0.0, 0.0);

var torus: object = TorusGeometry(1.0, 0.4, 16, 32);
torus.setPosition(4.0, 0.0, 0.0);
torus.setRotation(1.0, 0.5, 0.0);

var plane: object = PlaneGeometry(10.0, 10.0);
plane.setPosition(0.0, -2.0, 0.0);
plane.setRotation(1.57, 0.0, 0.0);

// Add to scene
scene.add(box);
scene.add(sphere);
scene.add(torus);
scene.add(plane);
scene.add(ambientLight);

// Render
canvas.render(scene, camera);

print("3D scene rendered!");
print("Left: Rotating cube | Center: Sphere | Right: Torus | Bottom: Plane");
print("Close window to exit.");

var running: int = 1;
while (running == 1) {
    pollEvents();
}
