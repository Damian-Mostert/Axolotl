// Debug 3D rendering
print("=== 3D Debug Test ===");

print("1. Creating canvas...");
var canvas: object = createCanvas(800, 600, "3D Debug");
print("Canvas created");

print("2. Creating box...");
var box: object = createBox(2.0, 2.0, 2.0);
print("Box created");

print("3. Creating camera...");
var camera: object = createCamera(60.0);
print("Camera created");

print("4. Setting camera position...");
camera.setPosition(0.0, 0.0, 5.0);
print("Camera positioned at (0, 0, 5)");

print("5. Setting box position...");
box.setPosition(0.0, 0.0, -2.0);
print("Box positioned at (0, 0, -2)");

print("6. Clearing canvas to black...");
canvas.fillStyle("#000000");
canvas.fillRect(0, 0, 800, 600);
print("Canvas cleared");

print("7. Setting stroke color to green...");
canvas.strokeStyle("#00ff00");
print("Stroke color set");

print("8. Rendering mesh...");
canvas.renderMesh(box, camera);
print("Mesh rendered");

print("9. Presenting to screen...");
canvas.render();
print("Presented");

print("10. Waiting 5 seconds...");
var start: int = millis();
while (millis() - start < 5000) {
    pollEvents();
}

print("=== Test Complete ===");
