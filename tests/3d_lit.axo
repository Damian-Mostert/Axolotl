// 3D with Lighting
print("Creating lit 3D scene...");

var canvas: object = createCanvas(800, 600, "3D Lighting");
var box: object = createBox(2.0, 2.0, 2.0);
var sphere: object = createSphere(1.5, 24);
var camera: object = createCamera(60.0);

var light: object = createLight(5.0, 5.0, 5.0);
light.setIntensity(1.5);

var blueMat: object = createMaterial("#3366ff");
blueMat.setProperties(0.2, 0.8, 0.6, 32.0);

var redMat: object = createMaterial("#ff3333");
redMat.setProperties(0.3, 0.7, 0.4, 16.0);

camera.setPosition(0.0, 2.0, 8.0);
box.setPosition(-3.0, 0.0, 0.0);
sphere.setPosition(3.0, 0.0, 0.0);

canvas.fillStyle("#000000");
canvas.fillRect(0, 0, 800, 600);

canvas.strokeStyle("#00ff00");
canvas.renderMesh(box, camera);

canvas.strokeStyle("#ff0000");
canvas.renderMesh(sphere, camera);

canvas.render();

print("Rendered with lighting!");
print("Close window to exit");

var start: int = millis();
while (millis() - start < 5000) {
    pollEvents();
}

print("Done");
