// Wolf in Street Environment
print("Loading Wolf in Street...");

const canvas: object = createCanvas(1280, 720);
const scene: object = createScene();

// Load street environment
const world: object = loadOBJ("./src/assets/Street environment_V01.obj");
world.setPosition(0.0, 0.0, 0.0);
scene.add(world);

print("Street loaded");

// Load wolf
const wolf: object = loadOBJ("./src/assets/Wolf_obj.obj");
wolf.setPosition(0.0, 0.0, 0.0);
scene.add(wolf);

print("Wolf loaded");

// Camera with dev mode
const camera: object = PerspectiveCamera(60.0);
camera.setPosition(0.0, 2.0, 8.0);
camera.lookAt(0.0, 1.0, 0.0);
enableDevMode(camera);

// Lighting
const sun: object = PointLight("#FFFFFF", 5.0);
sun.setPosition(10.0, 20.0, 10.0);
scene.add(sun);

const backLight: object = PointLight("#FFFFFF", 3.0);
backLight.setPosition(-10.0, 15.0, -10.0);
scene.add(backLight);

const ambient: object = AmbientLight("#FFFFFF", 1.2);
scene.add(ambient);

print("Scene ready!");

var time: float = 0.0;
var running: int = 1;

while (running == 1) {
    running = handleDevInput();
    updateDevCamera();
    
    time = time + 0.01;
    wolf.setRotation(0.0, time * 0.3, 0.0);
    
    canvas.render(scene, camera);
}

print("Done.");
