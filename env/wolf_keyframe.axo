// Wolf Animation - Keyframe System
print("Wolf Animation Demo");

const canvas: object = createCanvas(800, 600);
const scene: object = createScene();
const wolf: object = loadOBJ("./src/assets/Wolf_obj.obj");

// Apply texture
wolf.setTexture("./src/assets/textures/Wolf_Body.jpg");
wolf.setPosition(0.0, 0.0, 0.0);
scene.add(wolf);

// Create bones
const spine: int = wolf.createBone("spine", -1);
const leg: int = wolf.createBone("leg", spine);

// Create walk animation
const walk: int = wolf.createAnimation("walk", 2.0);
wolf.addAnimKey(walk, "leg", 0.0, 0.0, 0.0, 0.0, 0);
wolf.addAnimKey(walk, "leg", 1.0, 0.5, 0.0, 0.0, 1);
wolf.addAnimKey(walk, "leg", 2.0, 0.0, 0.0, 0.0, 0);

// Play animation
wolf.playAnimation(walk);

// Setup camera
const camera: object = PerspectiveCamera(60.0);
camera.setPosition(0.0, 2.0, 5.0);
camera.lookAt(0.0, 1.0, 0.0);

// Add lighting
const light: object = PointLight("#FFFFFF", 2.0);
light.setPosition(3.0, 5.0, 3.0);
scene.add(light);

const ambient: object = AmbientLight("#FFFFFF", 0.5);
scene.add(ambient);

// Add ground
const ground: object = PlaneGeometry(20.0, 20.0);
ground.setPosition(0.0, -0.5, 0.0);
ground.setRotation(1.57, 0.0, 0.0);
ground.setColor("#8B7355");
scene.add(ground);

print("Animation playing...");

var running: int = 1;
while (running == 1) {
    pollEvents();
    
    // Update animation
    wolf.updateAnimation(0.016);
    
    // Follow wolf with camera
    followTarget(camera, wolf, 6.0, 2.5);
    
    // Render
    canvas.render(scene, camera);
}

print("Done.");
