const canvas: object = createCanvas(800, 600)
const scene: object = createScene()

setGraphics(scene, {
    msaa: 1,
    msaaSamples: 4,
    depthTest: 1,
    smoothing: 1,
    shadows: 1,
    shadowIntensity: 0.5,
    fog: 1,
    fogDensity: 0.04,
    fogColor: "#636e72",
    backgroundColor:"#7bbeeb"
});

const camera: object = PerspectiveCamera(60)
camera.setPosition(0, 4, 25)

const player: object = loadOBJ("./src/assets/Wolf_obj.obj")
player.setPosition(10, 3, 20)
player.applyMTL("./src/assets/Wolf_obj.mtl")
//player.setTexture("./src/assets/textures/Wolf_Body.jpg")
scene.add(player)

const ground: object = loadOBJ("./src/assets/desert city.obj")
ground.setPosition(0, -20, 0)
ground.setBounciness(0);
scene.add(ground)

const sun: object = PointLight("#ffeeaa", 2)

sun.setPosition(20, 30, 10)
scene.add(sun)


var angle: float = 0.0
var canJump: int = 1
var playerSpeed: float = 0.5
var jumpStrength: float = 0.3

enableDevMode(camera);

var canJump: int = 1

while (handleDevInput() == 1) {
    canvas.fillStyle("#7bbeebff");
    canvas.fillRect(0, 0, 800, 600);
    
    updateDevCamera();
    const keys: object = getKeyState()

    if (keys.left == 1) angle = angle - 0.05
    if (keys.right == 1) angle = angle + 0.05

    if (keys.up == 1)
        player.moveBy(sin(angle) * playerSpeed, 0, cos(angle) * playerSpeed)
    if (keys.down == 1)
        player.moveBy(0.0 - sin(angle) * playerSpeed, 0, 0.0 - cos(angle) * playerSpeed)

    const isGrounded: int = applyPhysics(player, -0.02, ground)
    
    if (keys.space == 1 && canJump == 1 && isGrounded == 1) {
        player.addVelocity(0, jumpStrength, 0)
        canJump = 0
    }
    if (keys.space == 0)
        canJump = 1

    const pos: object = player.getPosition()
    const normal: object = player.getGroundNormal()
    const tiltX: float = atan2(normal.z, normal.y)
    const tiltZ: float = atan2(0.0 - normal.x, normal.y)
    player.setRotation(tiltX, angle, tiltZ)

    followTarget(camera, player, 6.0, 2.5)
    sun.setPosition(pos.x + 20, 30, pos.z + 10)
    canvas.render(scene, camera)
}
