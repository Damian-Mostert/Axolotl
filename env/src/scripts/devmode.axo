const wolf: object = loadOBJ("./src/assets/Wolf_obj.obj")
wolf.setTexture("./src/assets/textures/Wolf_Body.jpg")

// Create bones
const spine: int = wolf.createBone("spine", -1)
const leg: int = wolf.createBone("leg", spine)

// Create walk animation
const walk: int = wolf.createAnimation("walk", 2.0)
wolf.addAnimKey(walk, "leg", 0.0, 0, 0, 0, 0)
wolf.addAnimKey(walk, "leg", 1.0, 0.5, 0, 0, 1)
wolf.addAnimKey(walk, "leg", 2.0, 0, 0, 0, 0)

wolf.playAnimation(walk)
scene.add(wolf)

while (running == 1) {
    wolf.updateAnimation(0.016)
    canvas.render(scene, camera)
}
