const canvas: object = createCanvas(800, 600);
const scene: object = createScene();
const camera: object = PerspectiveCamera(60);
camera.setPosition(0, 0, 35);
camera.lookAt(0, 0, 0);

const sun: object = PointLight("#ffeeaa", 2);
sun.setPosition(30, 40, 20);
scene.add(sun);

const planet: object = SphereGeometry(15, 32, 24);
planet.setPosition(0, 0, 0);
planet.setColor("#556633");
planet.setFriction(0.3);
planet.setBounciness(0.1);
scene.add(planet);

const player: object = BoxGeometry(0.8, 1.6, 0.8);
player.setPosition(0, 16, 0);
player.setColor("#3388ff");
scene.add(player);

const tree1: object = CylinderGeometry(0.3, 0.3, 2);
tree1.setPosition(8, 14, 0);
tree1.setColor("#664422");
scene.add(tree1);

const leaves1: object = SphereGeometry(1);
leaves1.setPosition(8, 16, 0);
leaves1.setColor("#228844");
scene.add(leaves1);

const tree2: object = CylinderGeometry(0.3, 0.3, 2);
tree2.setPosition(0, 14, 8);
tree2.setColor("#664422");
scene.add(tree2);

const leaves2: object = SphereGeometry(1);
leaves2.setPosition(0, 16, 8);
leaves2.setColor("#228844");
scene.add(leaves2);

const rock1: object = BoxGeometry(1, 1, 1);
rock1.setPosition(5, 16, 5);
rock1.setRotation(0.3, 0.5, 0.2);
rock1.setColor("#888888");
scene.add(rock1);

const rock2: object = BoxGeometry(0.8, 0.8, 0.8);
rock2.setPosition(-5, 16, -5);
rock2.setRotation(0.5, 0.2, 0.4);
rock2.setColor("#999999");
scene.add(rock2);

const ball1: object = SphereGeometry(0.6);
ball1.setPosition(3, 20, 3);
ball1.setColor("#ff6666");
scene.add(ball1);

const ball2: object = SphereGeometry(0.5);
ball2.setPosition(-3, 22, -3);
ball2.setColor("#66ff66");
scene.add(ball2);

const box1: object = BoxGeometry(0.7, 0.7, 0.7);
box1.setPosition(0, 24, -4);
box1.setColor("#6666ff");
scene.add(box1);

var angle: float = 0.0;

while (handleDevInput() == 1) {
    const keys: object = getKeyState();
    
    const pos: object = player.getPosition();
    var px: float = 0.0;
    var py: float = 0.0;
    var pz: float = 0.0;
    px = px + pos.x;
    py = py + pos.y;
    pz = pz + pos.z;
    const dist: float = sqrt(px * px + py * py + pz * pz);
    
    var radX: float = px / dist * 1.0;
    var radY: float = py / dist * 1.0;
    var radZ: float = pz / dist * 1.0;
    
    var rightX: any = 0.0 - radZ;
    var rightY: any = 0.0;
    var rightZ: any = radX;
    const rightLen: float = sqrt(rightX * rightX + rightZ * rightZ);
    if (rightLen > 0.001) {
        rightX = rightX / rightLen;
        rightZ = rightZ / rightLen;
    }
    
    var fwdX: float = rightX * cos(angle) + rightZ * sin(angle);
    var fwdY: float = 0.0;
    var fwdZ: float = 0.0 - rightX * sin(angle) + rightZ * cos(angle);
    
    if (keys.left == 1) { angle = angle + 0.05; }
    if (keys.right == 1) { angle = angle - 0.05; }
    
    if (keys.up == 1) {
        player.addVelocity(fwdX * 0.03, fwdY * 0.03, fwdZ * 0.03);
    }
    if (keys.down == 1) {
        player.addVelocity(0.0 - fwdX * 0.03, 0.0 - fwdY * 0.03, 0.0 - fwdZ * 0.03);
    }
    if (keys.space == 1) {
        player.addVelocity(0.0 - radX * 0.15, 0.0 - radY * 0.15, 0.0 - radZ * 0.15);
    }
    
    applyAttractionToMesh(player, planet);
    handleCollision(player, planet, tree1, tree2, rock1, rock2);
    
    applyAttractionToMesh(ball1, planet);
    handleCollision(ball1, planet, tree1, tree2, rock1, rock2, player);
    
    applyAttractionToMesh(ball2, planet);
    handleCollision(ball2, planet, tree1, tree2, rock1, rock2, player);
    
    applyAttractionToMesh(box1, planet);
    handleCollision(box1, planet, tree1, tree2, rock1, rock2, player);
    
    const upX: float = 0.0 - radX;
    const upY: float = 0.0 - radY;
    const upZ: float = 0.0 - radZ;
    
    const rotY: float = atan2(fwdX, fwdZ);
    const rotX: float = atan2(upY, sqrt(upX * upX + upZ * upZ));
    
    player.setRotation(rotX, rotY, 0);
    
    const playerPos: object = player.getPosition();
    const camDist: float = 10.0;
    camera.setPosition(
        playerPos.x - sin(angle) * camDist,
        playerPos.y + 4,
        playerPos.z - cos(angle) * camDist
    );
    camera.lookAt(playerPos.x, playerPos.y, playerPos.z);
    
    canvas.render(scene, camera);
}
