// Character with twisting bone animation
print("Starting twist animation");

var canvas: object = createCanvas(800, 600, "Twist Animation");
var scene: object = createScene();
var camera: object = PerspectiveCamera(60.0);
camera.setPosition(2.0, 2.0, 8.0);
camera.lookAt(0.5, 1.0, 0.25);

var character: object = loadOBJ("creature/character.obj");
character.setPosition(0.0, 0.0, 0.0);
character.setColor("#88AAFF");
scene.add(character);

var spine: int = character.createBone("spine", -1);

character.addAnimation("twist", func(state: object) -> void {
    var t = state.time;
    character.setBonePose(spine, 0.0, 0.0, 0.0, sin(t * 2.0) * 0.8, cos(t * 2.0) * 0.5, sin(t * 1.5) * 0.3);
});

character.playAnimCallback("twist");

var light: object = PointLight("#FFFFFF", 1.5);
light.setPosition(5.0, 8.0, 5.0);
scene.add(light);

var ambient: object = AmbientLight("#FFFFFF", 0.5);
scene.add(ambient);

var running: int = 1;
while (running == 1) {
    pollEvents();
    character.updateAnimCallback(0.016);
    canvas.render(scene, camera);
}

print("Done.");
